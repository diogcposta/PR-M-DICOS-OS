{
  "name": "pr-medicos-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "demo:generate": "tsx scripts/generate-synthetic-data.ts",
    "demo:seed": "tsx scripts/generate-synthetic-data.ts && tsx scripts/seed-demo.ts",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "producao:generate": "prisma generate --config prisma.production.config.ts && DATABASE_URL=${DATABASE_URL:-postgresql://unused@localhost:5432/unused} prisma generate",
    "producao:migrate": "prisma migrate deploy --config prisma.production.config.ts",
    "producao:setup": "npm run producao:generate && npm run producao:migrate && tsx scripts/producao/setup-db.ts",
    "producao:seed": "tsx scripts/producao/setup-db.ts --reset",
    "producao:studio": "prisma studio --config prisma.production.config.ts",
    "test:producao": "vitest run --project unit --project production",
    "test:e2e:producao": "playwright test --config playwright.producao.config.ts",
    "gas:build": "node apps-script/build.mjs",
    "gas:preview": "node apps-script/build.mjs --preview && node apps-script/serve-preview.mjs",
    "test:e2e:gas": "playwright test --config playwright.apps-script.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "next": "16.3.4",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^28.0.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@12.11.1": true
  }
}
